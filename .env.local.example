NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Receipt OCR, nutrition-label and expiry-date scanning, and pantry chat
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — only needed to contribute corrected barcodes back to
# Open Food Facts. Register at https://world.openfoodfacts.org/cgi/user.pl
# Leave unset and that feature stays off; nothing else is affected.
OFF_USER_ID=
OFF_PASSWORD=

# Optional. Set to 1 only after Google sign-in is configured in Supabase
# (Authentication > Providers > Google). Leave unset and the button is hidden.
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Optional. Comma-separated email(s) that see the "Add Demo Data" button.
# UI-only — see src/lib/admin.ts for what that does and does not mean.
# Leave unset and nobody sees the button.
NEXT_PUBLIC_ADMIN_EMAILS=

# Optional. Reminders while the app is closed (Web Push). Leave all of these
# unset and the feature stays off; nothing else is affected. To turn it on:
#   1. run db/supabase-schema-push.sql in Supabase
#   2. npx web-push generate-vapid-keys   (prints a public and a private key)
#   3. set these in Vercel (Settings > Environment Variables), never in git:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Supabase > Project Settings > API > service_role. Server only: it bypasses
# row-level security, so it must never get a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel sends it to the cron job as a bearer token.
CRON_SECRET=
