NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Receipt OCR, nutrition-label and expiry-date scanning, and pantry chat
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — only needed to contribute corrected barcodes back to
# Open Food Facts. Register at https://world.openfoodfacts.org/cgi/user.pl
# Leave unset and that feature stays off; nothing else is affected.
OFF_USER_ID=
OFF_PASSWORD=

# Optional — raw OCR responses are stored in MongoDB only when this is set.
# See docs/adr/0001-postgres-plus-mongodb.md before enabling it in production
# (privacy policy, retention). Leave empty and nothing changes.
MONGODB_URI=

# Optional — base URL of the category-model service (ml/service). When unset,
# /api/categorize answers from the keyword rules.
ML_SERVICE_URL=
