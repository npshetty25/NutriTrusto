# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets. The .example template is the one
# exception: it holds placeholders only, and without it a fresh clone has
# no record of which keys the app needs.
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Non-app material ────────────────────────────────────────
# Slide decks, reports, wireframes, deck-generation scripts and QA
# exports now live outside this repo in ../project-files/. These guards
# stay so such files don't creep back into the app folder.
ip.txt
*.pptx
*.pdf
_ppt_extract*/
_final_extract/
wireframe/
*_text_dump.txt
qa_jpg/
qa_test.*
pptxgen_smoke.*
generate-presentation.*

# ── Superseded root lib/ (the real one is src/lib/) ──────────
/lib/
