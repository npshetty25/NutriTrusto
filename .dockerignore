# Anything listed here is not sent to the Docker daemon, which keeps the build
# context small and keeps secrets and local state out of image layers.
node_modules
.next
.git
.github

# secrets and local config
.env
.env.*
!.env*.example

# not part of the running app
docs
e2e
perf
db
scripts
coverage
test-results
playwright-report
public/portfolio-screenshots
*.md
!README.md
.claude
.impeccable
.agents
*.tsbuildinfo
Dockerfile
docker-compose.yml
